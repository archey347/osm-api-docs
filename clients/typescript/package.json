{
  "name": "@archey347/osm-api-client",
  "version": "0.4.0",
  "description": "Unofficial typed client and zod validators for the Online Scout Manager (OSM) API",
  "keywords": ["online-scout-manager", "onlinescoutmanager", "scouts", "api-client", "openapi", "zod"],
  "license": "MIT",
  "homepage": "https://scrapbook.archbar.me/osm-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archey347/osm-api-client.git",
    "directory": "clients/typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
